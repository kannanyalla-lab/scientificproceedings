# Postgres connection string
DATABASE_URL=postgres://ksp:ksp@localhost:5432/ksp

# Public URL of the site (used for share links, sitemap and citation meta tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel sign-in
ADMIN_EMAIL=editor@example.com
ADMIN_PASSWORD=change-me
# Long random string used to sign admin sessions (e.g. `openssl rand -base64 32`)
AUTH_SECRET=replace-with-a-long-random-string

# Where uploaded PDFs, images and manuscripts are stored on disk
UPLOAD_DIR=./uploads
