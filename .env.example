# Postgres connection string. Leave this commented out to use the built-in local
# database (stored in .data/db), which needs no installation.
# DATABASE_URL=postgres://user:password@localhost:5432/ksp

# Public URL of the site (used for share links, sitemap and citation meta tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Editor panel sign-in (/admin). Change these before going live.
ADMIN_EMAIL=editor@example.com
ADMIN_PASSWORD=admin123

# Long random string used to sign editor sessions (e.g. `openssl rand -base64 32`)
AUTH_SECRET=replace-with-a-long-random-string

# Where uploaded files are stored when not using Vercel Blob
UPLOAD_DIR=./uploads

# Set automatically when you add a Vercel Blob store; uploads then go to Vercel Blob.
# BLOB_READ_WRITE_TOKEN=

# Importing editions from PDF (Editor panel > Import edition) uses the Claude API.
# The key can also be pasted on that page instead (it is then kept in .data/settings.json).
# ANTHROPIC_API_KEY=sk-ant-...
# Model used to read editions (default claude-opus-5-5)
# KSP_IMPORT_MODEL=claude-opus-5-5
